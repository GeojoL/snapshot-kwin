#!/usr/bin/env bash
# Protected mode: the daemon runs as a system service, so stopping or disabling
# it needs root (sudo). A killed daemon is started again by systemd.
#
#   ./install.sh && sudo tools/install-system   install
#   sudo tools/install-system --uninstall       back to the per-user service (then ./install.sh)
#
# The unit runs the code in this checkout as the desktop user. Its interpreter
# copy lives in /usr/local/libexec, because SELinux does not let a system service
# execute files in a home directory; the KWin authorization .desktop points at it.
# snapshot_kwin.launch waits for the Plasma Wayland session and takes over its
# environment, since a system unit starts outside the session.
set -euo pipefail

[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
TARGET_USER="${SUDO_USER:-}"
[ -n "$TARGET_USER" ] && [ "$TARGET_USER" != root ] || { echo "run via sudo from the desktop user" >&2; exit 1; }
TARGET_UID="$(id -u "$TARGET_USER")"
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
LIBEXEC=/usr/local/libexec/snapshot-kwin
PY_COPY="$LIBEXEC/snapshot-kwin-python"
DESKTOP=/usr/local/share/applications/io.github.geojol.SnapshotKwin.desktop
UNIT=/etc/systemd/system/snapshot-kwin.service

as_user() {
  runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="/run/user/$TARGET_UID" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$TARGET_UID/bus" "$@"
}

if [ "${1:-}" = "--uninstall" ]; then
  systemctl disable --now snapshot-kwin.service 2>/dev/null || true
  rm -f -- "$UNIT" "$DESKTOP"
  rm -rf -- "$LIBEXEC"
  systemctl daemon-reload
  echo "protected service removed; run ./install.sh (no sudo) for the per-user service"
  exit 0
fi

# authorized interpreter copy outside the home directory
install -d -m 0755 "$LIBEXEC" "$(dirname "$DESKTOP")"
install -m 0755 "$(readlink -f /usr/bin/python3)" "$PY_COPY.new"
mv -f "$PY_COPY.new" "$PY_COPY"
cat > "$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=snapshot-kwin
Comment=Instant screenshot daemon for KDE Plasma (Wayland)
Exec=$PY_COPY -m snapshot_kwin.app
NoDisplay=true
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
EOF
chmod 0644 "$DESKTOP"

cat > "$UNIT" <<EOF
[Unit]
Description=snapshot-kwin screenshot daemon (stopping it needs root)
After=user@$TARGET_UID.service

[Service]
User=$TARGET_USER
Environment=PYTHONPATH=$SRC
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=$PY_COPY -m snapshot_kwin.launch
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
EOF
chmod 0644 "$UNIT"

# only one daemon: retire the per-user unit; install.sh sees $UNIT and installs
# only the per-user parts (its own interpreter copy and .desktop would shadow ours)
as_user systemctl --user disable --now snapshot-kwin.service >/dev/null 2>&1 || true
as_user "$SRC/install.sh" >/dev/null

systemctl daemon-reload
systemctl enable snapshot-kwin.service >/dev/null
systemctl restart snapshot-kwin.service
echo "snapshot-kwin protected service installed: systemctl status snapshot-kwin"
